# Скопируйте в .env и заполните. Файл .env в git не коммитить.

# Токен от @BotFather
BOT_TOKEN=123456:AA...

# Ваш телеграм-юзернейм БЕЗ собаки. Бот привяжет вас как оператора,
# когда вы напишете ему /start с этого аккаунта.
ADMIN_USERNAME=your_username

# Необязательно: если знаете свой числовой chat_id, впишите — привязка произойдёт сразу.
# Узнать можно командой /whoami в боте.
ADMIN_CHAT_ID=

# Путь к файлу базы
DB_PATH=./data/bot.db

# Лимит заказов от одного пользователя в час (защита от спама)
MAX_ORDERS_PER_HOUR=5
